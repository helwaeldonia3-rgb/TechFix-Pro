{
  "$schema": "http://json.schemastore.org/appsettings.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "TechFixPro": {
    "AppName": "TechFix Pro",
    "Version": "1.0.0",
    "DatabasePath": "TechFixPro.db",
    "LogRetentionDays": 90,
    "MaxLogEntries": 100000,
    "EnableAutoDetection": true,
    "AutoDetectionInterval": 5000,
    "DefaultTimeout": 30000
  }
}