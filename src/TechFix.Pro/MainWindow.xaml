<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TechFix.Pro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TechFix Pro - Professional Smartphone Repair Tool"
    Width="1600"
    Height="900"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid ColumnSpacing="0" RowSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.ColumnSpan="2" Height="60" Background="{ThemeResource SolidBackgroundFillColorBase}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Padding="20,0">
                <TextBlock Text="🔧" FontSize="28" Margin="0,0,10,0" />
                <TextBlock Text="TechFix Pro" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Sidebar Navigation -->
        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            DisplayMode="Compact"
            IsSettingsVisible="True"
            IsPaneOpen="True"
            PaneDisplayMode="Left">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Dashboard" Tag="dashboard" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Icon="DevicesHub" Content="Device Detection" Tag="device-detection" />
                <NavigationViewItemHeader Content="Platforms" />
                <NavigationViewItem Content="Qualcomm" Tag="qualcomm" />
                <NavigationViewItem Content="MediaTek" Tag="mediatek" />
                <NavigationViewItem Content="Samsung" Tag="samsung" />
                <NavigationViewItem Content="Apple" Tag="apple" />
                <NavigationViewItem Content="Unisoc" Tag="unisoc" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Icon="Document" Content="Firmware Manager" Tag="firmware" />
                <NavigationViewItem Icon="Plug" Content="Drivers" Tag="drivers" />
                <NavigationViewItem Icon="AllApps" Content="Tools" Tag="tools" />
                <NavigationViewItem Icon="DocumentSet" Content="Logs" Tag="logs" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Padding="0,8">
                    <NavigationViewItem Icon="Setting" Content="Settings" Tag="settings" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>