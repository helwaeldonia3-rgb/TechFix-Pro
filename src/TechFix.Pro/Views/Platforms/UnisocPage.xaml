<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TechFix.Pro.Views.Platforms.UnisocPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="10">
            <TextBlock Text="Unisoc" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Manage Unisoc SC and SG series devices" Foreground="{ThemeResource TextFillColorSecondary}" />
        </StackPanel>

        <!-- Quick Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Content="Detect Device" Padding="12,8" />
            <Button Content="Preloader Mode" Padding="12,8" />
            <Button Content="Flash Firmware" Padding="12,8" />
            <Button Content="Install Drivers" Padding="12,8" />
        </StackPanel>

        <!-- Content -->
        <ScrollView Grid.Row="2">
            <StackPanel Spacing="20">
                <!-- Device Info -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Device Information" FontSize="16" FontWeight="Bold" />
                        <Grid ColumnSpacing="20" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Processor Series" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                                <TextBlock Text="Status: Not Connected" FontSize="14" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Frequency" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                                <TextBlock Text="--" FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Unisoc Specific Tools -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Available Tools" FontSize="16" FontWeight="Bold" />
                        <ListView SelectionMode="None">
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="✓" Foreground="Green" />
                                    <TextBlock Text="Unisoc USB Driver" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="✓" Foreground="Green" />
                                    <TextBlock Text="Unisoc Flash Tool" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="✓" Foreground="Green" />
                                    <TextBlock Text="Preloader Detector" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>